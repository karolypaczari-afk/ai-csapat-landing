# ai-csapat.genmarketer.hu — PROD landoló („Az AI csapatod", MISSION CONTROL verzió)
# Cutover-kész .htaccess. A deploy a repo-gyökérbe .htaccess-ként másolja.

Options -Indexes
DirectoryIndex index.html
AddDefaultCharset utf-8

# --- MIME: a videók helyes típussal menjenek (Range-kéréshez is) ---
AddType video/mp4 .mp4
AddType video/webm .webm
AddType image/webp .webp
AddType text/plain .txt

# --- A régi angol útvonal: útvonal-hű, ÖRÖK 301 a genmarketer.eu-ra ---
# Az angol üzletág 2026-08-02 óta a `genmarketer.eu` gyökerén él (docs/33), és az
# `/en/*` azóta 301-gyel oda megy. A szabály eddig CSAK az élő szerveren létezett:
# a repo `htaccess-prod`-jában nem volt benne, pedig a `sync-landing-mirror.yml`
# EBBŐL a fájlból írja a docroot `.htaccess`-ét — vagyis a következő mirror-sync
# némán levette volna a 301-et, és az `/en/` újra kiszolgált, indexelhető
# duplikátummá vált volna a `.eu` mellett. Élőben mérve 2026-08-04-én, hogy a
# leképezés útvonal-hű és minden cél 200-at ad (`/en/terms/` → `/terms/` stb.).
# A `landing-ai-csapatod/en/` forrásmappa SZÁNDÉKOSAN megmarad: abból épül a `.eu`
# snapshot (docs/33) — csak kiszolgálni nem szabad többé.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule ^en$        https://genmarketer.eu/ [R=301,L]
  RewriteRule ^en/(.*)$   https://genmarketer.eu/$1 [R=301,L]
</IfModule>

# --- VCS / dotfile védelem (a .git sosem szolgálható ki) ---
RedirectMatch 404 /\.git(/|$)
<FilesMatch "^\.">
  Require all denied
</FilesMatch>

# --- Gyorsítótár: HTML és CSS/JS azonnal frissüljön; assetek hosszan cache-elhetők ---
<IfModule mod_headers.c>
  <FilesMatch "\.html?$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
  <FilesMatch "\.(css|js|mjs)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
  <FilesMatch "\.(txt|xml)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
  <FilesMatch "\.(webp|png|jpe?g|svg|gif|ico|woff2?)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>
  <FilesMatch "\.(mp4|webm)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>
  Header set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# --- A magyar /checkout/ nem indexelhető (Károly, 2026-07-31) ---
# Ez a saját, HUF-os Stripe-pénztár oldala. 2026-07-31 óta EGYETLEN CTA sem mutat rá:
# a magyar út az előfizetéses tudástár-pénztárra megy (Woo 1992/1993). Az oldal viszont
# él, és még az EGYSZERI árat + a 30 napos garanciát mutatja — árva, mégis indexelhető
# duplikátumként ellentmondana az éles ajánlatnak.
#
# A `<meta name="robots" content="noindex, nofollow">` már benne van a HTML-ben; ez a
# fejléc a második, erősebb réteg: akkor is érvényes, ha a lekérő nem parse-ol HTML-t.
#
# A minta SZÁNDÉKOSAN horgonyzott (`^/checkout`): az `/en/checkout/` egy MŰKÖDŐ, EUR-os
# pénztár — azt ez a szabály nem érintheti. (Neki is van meta-noindexe, de a hatóköre
# külön döntés, az EN körhöz tartozik.)
SetEnvIf Request_URI "^/checkout(/(index\.html)?)?$" GM_NOINDEX=1
<IfModule mod_headers.c>
  Header always set X-Robots-Tag "noindex, nofollow" env=GM_NOINDEX
</IfModule>

# --- LiteSpeed: ne full-page-cache-elje a HTML-t → azonnali frissülés ---
<IfModule LiteSpeed>
  CacheDisable public /
</IfModule>

# --- Tömörítés ---
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>
