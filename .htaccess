# ai-csapat.genmarketer.hu — PROD landoló („Az AI csapatod", MISSION CONTROL verzió)
# Cutover-kész .htaccess. A deploy a repo-gyökérbe .htaccess-ként másolja.

Options -Indexes
DirectoryIndex index.html
AddDefaultCharset utf-8

# --- MIME: a videók helyes típussal menjenek (Range-kéréshez is) ---
AddType video/mp4 .mp4
AddType video/webm .webm
AddType image/webp .webp
AddType text/plain .txt

# --- VCS / dotfile védelem (a .git sosem szolgálható ki) ---
RedirectMatch 404 /\.git(/|$)
<FilesMatch "^\.">
  Require all denied
</FilesMatch>

# --- Gyorsítótár: HTML és CSS/JS azonnal frissüljön; assetek hosszan cache-elhetők ---
<IfModule mod_headers.c>
  <FilesMatch "\.html?$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
  <FilesMatch "\.(css|js|mjs)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
  <FilesMatch "\.(txt|xml)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
  <FilesMatch "\.(webp|png|jpe?g|svg|gif|ico|woff2?)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>
  <FilesMatch "\.(mp4|webm)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>
  Header set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# --- LiteSpeed: ne full-page-cache-elje a HTML-t → azonnali frissülés ---
<IfModule LiteSpeed>
  CacheDisable public /
</IfModule>

# --- Tömörítés ---
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>
