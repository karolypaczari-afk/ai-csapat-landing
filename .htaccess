# ai-csapat.genmarketer.hu — PROD landoló („Az AI csapatod", MISSION CONTROL verzió)
# Cutover-kész .htaccess. A deploy a repo-gyökérbe .htaccess-ként másolja.

Options -Indexes
DirectoryIndex index.html
AddDefaultCharset utf-8

# --- MIME: a videók helyes típussal menjenek (Range-kéréshez is) ---
AddType video/mp4 .mp4
AddType video/webm .webm
AddType image/webp .webp
AddType text/plain .txt

# --- Az angol csatorna elköltözött: /en/* → genmarketer.eu (Károly, 2026-08-02) ---
#
# Az angol oldal saját domaint kapott. Amíg mindkét útvonal 200-at adott, két
# indexelhető angol oldal versenyzett egymással ugyanazzal a tartalommal, és a
# hreflang sem volt viszonos — ilyenkor a Google az egész fürtöt eldobja.
#
# ÚTVONAL-HŰ a leképezés: /en/checkout/ → genmarketer.eu/checkout/, mert a .eu-n
# az angol oldal MAGA a gyökér. Egy vak /en/* → gyökér átirányítás a mélylinkeket
# (pénztár, köszönőoldal, manage) mind a főoldalra dobná, és a már KIKÜLDÖTT
# portál-linkek törnének el — azok e-mailben élnek, nem tudjuk visszahívni őket.
#
# 301 és nem 302: ez végleges. A szabály a docs/33 8c szerint ÖRÖKRE marad, akkor
# is, ha az /en/ mappa egyszer törlődik a docrootból.
#
# ⚠️ 2026-08-04: EZ A BLOKK 2026-08-02 ÓTA CSAK AZ ÉLŐ SZERVEREN LÉTEZETT.
# Kézzel került a docroot `.htaccess`-ébe, a repo forrásába soha — pedig a
# `sync-landing-mirror.yml` EBBŐL a fájlból írja a docroot `.htaccess`-ét. Két
# következménye volt, és a második két napig láthatatlan maradt:
#   1. a következő mirror-sync NÉMÁN levette volna a saját 301-ét, és az `/en/`
#      újra kiszolgált, indexelhető duplikátummá vált volna a `.eu` mellett;
#   2. a kézi szerkesztéstől a docroot git-munkafája TARTÓSAN PISZKOS lett ezen
#      az egy fájlon → a `git merge --ff-only` minden olyan commitnál elbukik,
#      ami szintén hozzányúl a `.htaccess`-hez. 08-02 és 08-04 között egyetlen
#      ilyen commit sem volt, ezért minden deploy zöld maradt — a hiba ott ült,
#      csak nem volt mihez hozzáérnie.
# A szöveg SZÁNDÉKOSAN az élő, bizonyítottan működő `RedirectMatch` alak (nem
# `RewriteRule`): élőben mérve 2026-08-04-én, hogy útvonal-hű és minden cél
# 200-at ad (`/en/terms/` → `/terms/`, `/en/checkout/` → `/checkout/` stb.).
# A `landing-ai-csapatod/en/` forrásmappa MEGMARAD: abból épül a `.eu` snapshot
# (docs/33) — csak kiszolgálni nem szabad többé.
RedirectMatch 301 ^/en/(.*)$ https://genmarketer.eu/$1
RedirectMatch 301 ^/en$ https://genmarketer.eu/

# --- VCS / dotfile védelem (a .git sosem szolgálható ki) ---
RedirectMatch 404 /\.git(/|$)
<FilesMatch "^\.">
  Require all denied
</FilesMatch>

# --- Gyorsítótár: HTML és CSS/JS azonnal frissüljön; assetek hosszan cache-elhetők ---
<IfModule mod_headers.c>
  <FilesMatch "\.html?$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
  <FilesMatch "\.(css|js|mjs)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
  <FilesMatch "\.(txt|xml)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
  <FilesMatch "\.(webp|png|jpe?g|svg|gif|ico|woff2?)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>
  <FilesMatch "\.(mp4|webm)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>
  Header set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# --- A magyar /checkout/ nem indexelhető (Károly, 2026-07-31) ---
# Ez a saját, HUF-os Stripe-pénztár oldala. 2026-07-31 óta EGYETLEN CTA sem mutat rá:
# a magyar út az előfizetéses tudástár-pénztárra megy (Woo 1992/1993). Az oldal viszont
# él, és még az EGYSZERI árat + a 30 napos garanciát mutatja — árva, mégis indexelhető
# duplikátumként ellentmondana az éles ajánlatnak.
#
# A `<meta name="robots" content="noindex, nofollow">` már benne van a HTML-ben; ez a
# fejléc a második, erősebb réteg: akkor is érvényes, ha a lekérő nem parse-ol HTML-t.
#
# A minta SZÁNDÉKOSAN horgonyzott (`^/checkout`): az `/en/checkout/` egy MŰKÖDŐ, EUR-os
# pénztár — azt ez a szabály nem érintheti. (Neki is van meta-noindexe, de a hatóköre
# külön döntés, az EN körhöz tartozik.)
SetEnvIf Request_URI "^/checkout(/(index\.html)?)?$" GM_NOINDEX=1
<IfModule mod_headers.c>
  Header always set X-Robots-Tag "noindex, nofollow" env=GM_NOINDEX
</IfModule>

# --- LiteSpeed: ne full-page-cache-elje a HTML-t → azonnali frissülés ---
<IfModule LiteSpeed>
  CacheDisable public /
</IfModule>

# --- Tömörítés ---
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>
